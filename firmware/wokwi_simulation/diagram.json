    },
    {
      "type": "wokwi-led",
      "id": "led_green",
      "top": 180,
      "left": -120,
      "attrs": { "color": "green", "label": "TICK" }
    },
    {
      "type": "wokwi-led",
      "id": "led_yellow",
      "top": 180,
      "left": -160,
