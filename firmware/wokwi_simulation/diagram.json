    [ "esp:GND.1", "btn_red:1.1", "black", [ "v0" ] ],
    [ "esp:18", "r1:1", "green", [ "v0" ] ],
    [ "r1:2", "led_green:A", "green", [ "v0" ] ],
    [ "esp:GND.1", "led_green:C", "black", [ "v0" ] ],
    [ "esp:19", "r2:1", "yellow", [ "v0" ] ],
    [ "r2:2", "led_yellow:A", "yellow", [ "v0" ] ],
    [ "esp:GND.1", "led_yellow:C", "black", [ "v0" ] ],
    [ "esp:23", "r3:1", "red", [ "v0" ] ],
    [ "r3:2", "led_red:A", "red", [ "v0" ] ],
    [ "esp:GND.1", "led_red:C", "black", [ "v0" ] ]
